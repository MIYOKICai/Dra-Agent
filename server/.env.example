# ============ Agent 画布 server 环境变量示例 ============
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交真实密钥。

# ---------- LLM 服务商密钥 ----------

# DeepSeek 平台 API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 火山方舟（豆包）API Key（https://console.volcengine.com/ark）
ARK_API_KEY=

# 火山方舟对话模型（可选，默认 doubao-seed-1-6-flash-250815）
ARK_CHAT_MODEL=

# 火山方舟图像生成模型（可选，默认 doubao-seedream-4-0-250828）
ARK_IMAGE_MODEL=

# 智谱 AI API Key（https://open.bigmodel.cn）
ZHIPU_API_KEY=

# 智谱对话模型（可选，默认 glm-4-flash）
ZHIPU_CHAT_MODEL=

# 智谱图像生成模型（可选，默认 cogview-3-flash）
ZHIPU_IMAGE_MODEL=

# 智谱向量模型（可选，默认 embedding-3）
ZHIPU_EMBEDDING_MODEL=

# ---------- 自定义 OpenAI 兼容接入 ----------

# 自定义服务商 Base URL（OpenAI 兼容格式，例如 https://your-host/v1）
CUSTOM_BASE_URL=

# 自定义服务商 API Key
CUSTOM_API_KEY=

# 自定义服务商的对话模型名
CUSTOM_CHAT_MODEL=

# 自定义服务商的图像生成模型名
CUSTOM_IMAGE_MODEL=

# ---------- 其他 ----------

# 敏感词表文件路径（默认 server/sensitive-words.txt，文件不存在时会用内置词库自动创建；相对路径以 server 目录为基准）
SENSITIVE_WORDS_PATH=

# 知识库数据目录（存放知识库文档与索引数据）
KB_DATA_DIR=
